rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function getUserRole() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDoc) ? get(userDoc).data.role : 'user';
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isPsychologist() {
      return request.auth != null && getUserRole() == 'psychologist';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // FIX (IDOR — AT-02-A2): sebelumnya "allow read: if request.auth != null;"
      // mengizinkan SIAPA SAJA yang login (termasuk anonymous) membaca profil
      // pengguna lain. Sekarang hanya pemilik, psikolog, atau admin yang boleh.
      allow read: if isOwner(userId) || isPsychologist() || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Jurnal (Dienkripsi, jadi aman meski psikolog bisa 'read' secara aturan database)
    match /journals/{userId}/entries/{entryId} {
      allow read: if isOwner(userId) || isPsychologist() || isAdmin();
      allow write: if isOwner(userId);
    }

    // Sesi obrolan (Dienkripsi)
    match /journals/{userId}/sessions/{sessionId} {
      allow read: if isOwner(userId) || isPsychologist() || isAdmin();
      allow write: if isOwner(userId);
    }

    match /userState/{userId} {
      allow read: if isOwner(userId) || isPsychologist() || isAdmin();
      allow write: if isOwner(userId);
    }

    match /consultations/{codeId} {
      allow read, write: if request.auth != null;
    }

    // Statistik global (bisa dibaca semua, ditulis admin)
    match /stats/{statId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Live Chat Anonim
    match /chats/{chatId} {
      allow read: if isPsychologist() || isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isPsychologist() || isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null; // Kita percayakan akses ke dokumen parent (chatId) via aplikasi untuk filter lebih lanjut
      }
    }

    // Activity Logs (Non-Repudiation)
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      // Hanya bisa buat baru (append-only), tidak bisa diubah atau dihapus
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
